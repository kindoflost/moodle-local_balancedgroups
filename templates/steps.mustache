{{!
    @template local_balancedgroups/steps

    Step indicator of the balanced groups wizard.

    Context variables required for this template:
    * steps - list of steps (number, name, active, done)

    Example context (json):
    {
        "steps": [
            {"number": 1, "name": "People and data", "active": false, "done": true},
            {"number": 2, "name": "Priorities and rules", "active": true, "done": false},
            {"number": 3, "name": "Preview and create", "active": false, "done": false}
        ]
    }
}}
<ol class="local_balancedgroups-steps list-inline mb-3">
    {{#steps}}
    <li class="list-inline-item">
        {{#active}}<span class="badge bg-primary text-white" aria-current="step">{{number}}. {{name}}</span>{{/active}}
        {{^active}}<span class="badge {{#done}}bg-success text-white{{/done}}{{^done}}bg-light text-dark{{/done}}">{{number}}. {{name}}</span>{{/active}}
    </li>
    {{/steps}}
</ol>
